# Supabase project (Settings → API). The anon key is public; the service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of this app, used in sign-in and invite links.
APP_URL=http://localhost:3000
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts integration keys. Never change it after saving keys.
ENCRYPTION_KEY=
# Set to 1 after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH=0
